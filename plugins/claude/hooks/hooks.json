{
  "description": "synaptory plugin hooks for cross-session pipeline enforcement",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/synaptory-access-token-check.sh\"",
            "timeout": 20,
            "statusMessage": "Validating synaptory access token..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/synaptory-skills-fetch.sh\"",
            "timeout": 15,
            "statusMessage": "Syncing synaptory skill cache..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/synaptory-config-fetch.sh\"",
            "timeout": 10,
            "statusMessage": "Refreshing policy cache..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/synaptory-load-rules.sh\"",
            "timeout": 10,
            "statusMessage": "Loading Synaptory behavioral rules..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/synaptory-session-start.sh\"",
            "timeout": 10,
            "statusMessage": "Loading synaptory project context..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-guard.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for existing synaptory project..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/synaptory-otel-flush.sh\"",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/synaptory-session-end.sh\"",
            "timeout": 5,
            "async": true
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/synaptory-access-token-cleanup.sh\"",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/synaptory-reanchor.sh\"",
            "timeout": 10,
            "statusMessage": "Re-anchoring pipeline context..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/synaptory-inject-protocols.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/synaptory-verify-receipt.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/synaptory-loop-continue.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for remaining pipeline work..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/synaptory-pipeline-snapshot.sh\"",
            "timeout": 10,
            "async": true
          },
          {
            "type": "command",
            "command": "SYNAPTORY_HOOK_EVENT=Stop bash \"${CLAUDE_PLUGIN_ROOT}/hooks/synaptory-activity-ping.sh\"",
            "timeout": 5,
            "async": true
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/synaptory-otel-flush.sh\"",
            "timeout": 10,
            "async": true
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/synaptory-access-token-cleanup.sh\"",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/synaptory-activity-ping.sh\"",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/synaptory-tool-failure.sh\"",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/synaptory-stop-failure.sh\"",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/synaptory-post-compact.sh\"",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/synaptory-boundary-guard.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": "pipeline-state.json",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/synaptory-watch-drift.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": ".synaptory.yaml",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/synaptory-watch-drift.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
