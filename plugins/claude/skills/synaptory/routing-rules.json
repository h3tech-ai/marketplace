  "tiebreakers": [
    {
      "conflict": "review vs verify",
      "rule": "Review if 'my code / this code'. Verify if 'before launch / audit / harden / production ready'",
      "reason": "Verify implies multi-agent parallel audit; Review is single-agent read-only"
    },
    {
      "conflict": "test vs debug",
      "rule": "Debug if error/failure/crash/not working is described. Test if the code works and coverage is the goal",
      "reason": "Debug = active failure; Test = proactive quality"
    },
    {
      "conflict": "build vs debug",
      "rule": "Debug if there is a specific error description. Build if it is a new behaviour request",
      "reason": "Debug requires root-cause analysis; Build is additive"
    },
    {
      "conflict": "multiple modes match",
      "rule": "Pick the most specific: Debug > Story Buddy, Release > Code Review, Sprint > Build",
      "reason": "Specificity beats generality"
    },
    {
      "conflict": "reliability vs optimize",
      "rule": "Reliability if SLO, error budget, chaos, runbook, incident, or on-call is mentioned. Optimize if performance or scale is the goal without operational framing",
      "reason": "Reliability = operational engineering; Optimize = code/infra performance tuning"
    },
    {
      "conflict": "implement + story ID vs Build",
      "rule": "Story Buddy \u2014 Implement if a story ID pattern ([A-Z]+-\\d+ or US-\\d+) is present. Build (Scrum lifecycle) if no story ID.",
      "reason": "Story ID = story already in tracker. No story ID = new project requiring Inception."
    },
    {
      "conflict": "write tests + story ID vs Test",
      "rule": "Story Buddy \u2014 Test if a story ID is present. Test (standalone) if no story ID.",
      "reason": "Story ID enables AC-to-test traceability; standalone Test is general coverage work."
    },
    {
      "conflict": "story ID anywhere in request",
      "rule": "Story Buddy mode (role inferred from request context). Story ID overrides Build/Test/Review.",
      "reason": "Presence of a story ID signals per-story assistance intent, not a new feature request."
    },
    {
      "conflict": "doctor vs init",
      "rule": "Doctor if 'check', 'validate', 'diagnose', 'is it configured correctly', or 'doctor' is mentioned. Init if 'initialize', 'set up', or 'generate config' is the goal.",
      "reason": "Doctor is read-only diagnostic; Init generates/overwrites configuration."
    }
  ]
}
