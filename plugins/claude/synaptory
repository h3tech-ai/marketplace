_build_docker_images() {
  local ver="$1"
  echo "──── docker images (v${ver}) ────"
  # `set -e` is on (set -euo pipefail at top), so any docker build failure
  # aborts the whole ./synaptory build. Serial builds keep peak RAM under the
  # Docker Desktop VM cap (parallel builds OOMed during `apt-get install
  # build-essential`).
  local images=(
    "api:infra/docker/Dockerfile.api:api"
    "web:web/Dockerfile:web"
    "fixture-idp:infra/docker/Dockerfile.fixture-idp:api"
    "backup:infra/docker/Dockerfile.backup:infra/docker"
    "git-http:infra/docker/Dockerfile.git-http:infra/docker"
  )
  for spec in "${images[@]}"; do
    IFS=':' read -r svc dockerfile ctx <<< "$spec"
    local tag="synaptory-${svc}:v${ver}"
    echo "  building ${tag}  (-f ${dockerfile})"
    (cd "${REPO_ROOT}" && DOCKER_BUILDKIT=1 docker build \
      -f "${dockerfile}" \
      -t "${tag}" \
      --build-arg VERSION="${ver}" \
      "${ctx}") >/dev/null
  done
  echo "  ✓ images: ${#images[@]} tagged :v${ver}"
  echo ""
}

_build_cli_binaries() {
  local ver="$1"
  echo "──── CLI binaries (v${ver}) ────"
  local cli_dir="${REPO_ROOT}/cli"
  # Channel: SYNAPTORY_CHANNEL override (e2e harness) wins; otherwise infer from
  # PLUGIN_NAME suffix ("synaptory" → stable, "synaptory-next" → "next").
  local channel=""
  if [[ -n "${SYNAPTORY_CHANNEL:-}" ]]; then
    channel="${SYNAPTORY_CHANNEL}"
  elif [[ "${PLUGIN_NAME}" != "synaptory" ]]; then
    channel="${PLUGIN_NAME#synaptory-}"
  fi
  # SYNAPTORY_BUILD_CLI_TARGETS narrows the cross-compile to a space-separated
  # list of `os/arch` pairs. Empty (the default, and every release path) builds
  # all five, so `deploy prod` is byte-for-byte unchanged. CI's e2e subset sets
  # it to the one target it actually executes: the 5-platform compile measured
  # 69s of a 269s stack bring-up, and four of those binaries are never run.
  # Releases and `e2e_scope: full` keep all five, so the cross-platform compile
  # check still gates the way to prod.
  local -a target_args=()
  if [[ -n "${SYNAPTORY_BUILD_CLI_TARGETS:-}" ]]; then
    read -r -a target_args <<< "${SYNAPTORY_BUILD_CLI_TARGETS}"
    echo "  targets narrowed to: ${target_args[*]}"
  fi
  (cd "$cli_dir" && \
    VERSION="${ver}" \
    SYNAPTORY_CP_URL="${SYNAPTORY_CP_URL}" \
    SYNAPTORY_CHANNEL="${channel}" \
    SYNAPTORY_CP_ENTRA_TENANT_ID="${SYNAPTORY_CP_ENTRA_TENANT_ID}" \
    SYNAPTORY_CP_ENTRA_CLIENT_ID="${SYNAPTORY_CP_ENTRA_CLIENT_ID}" \
    ./scripts/build-all.sh "${target_args[@]+"${target_args[@]}"}")
  echo "  ✓ CLI binaries in ${cli_dir}/dist/  (channel=${channel:-stable})"
  echo ""
}

_stage_cli_to_dist() {
  local ver="$1"
  # Layout MUST be /cli/<ver>/binary (no `v` prefix). Both cli/scripts/
  # install.sh (line ~65) and cli/internal/cli/update.go (line ~119) fetch
  # `${BASE}/${version}/${asset}` — any older CLI in the field uses this
  # contract. Don't add a `v` prefix here without coordinating a CLI
  # release that knows the new path.
  echo "──── stage CLI → web/dist/cli/${ver}/ ────"
  local cli_dir="${REPO_ROOT}/cli"
  local web_cli_dir="${REPO_ROOT}/web/dist/cli"
  local out_dir="${web_cli_dir}/${ver}"
  mkdir -p "$out_dir"
  cp -f "$cli_dir"/dist/synaptory-* "$out_dir/"
  (cd "$out_dir" && shasum -a 256 synaptory-* | sed 's| \*\?| |' > sha256sums.txt)
  # C1 (#98): sign the checksum manifest with the CP Ed25519 key so the
  # in-field CLI can verify it against /v1/public-key — defends against a
  # compromised mirror serving a matching binary+sums pair (both would come
  # from the same host under TLS-only).
  #
  # #200: this used to be `if python3 sign-artifact.py … >/dev/null 2>&1`,
  # which threw away the reason signing failed. Releases 1.0.17 and 1.0.18
  # both silently shipped without a .sig because of it. The helper now owns
  # method selection (local key, else the running api container, which is the
  # only one that works on the prod runner), checks the signing key against
  # the CP's published one, and reports why it failed. Exit 1 means "required
  # and unavailable" and MUST abort the build; exit 2 is the best-effort skip
  # a dev laptop takes.
  local sign_rc=0
  bash "${REPO_ROOT}/infra/scripts/sign-release-checksums.sh" \
    "${out_dir}/sha256sums.txt" || sign_rc=$?
  if [[ "$sign_rc" -eq 1 ]]; then
    echo "  ✗ aborting: checksum signing is required and did not succeed." >&2
    exit 1
  fi
  cp -f "${REPO_ROOT}/cli/scripts/install.sh"  "${web_cli_dir}/install.sh"
  cp -f "${REPO_ROOT}/cli/scripts/install.ps1" "${web_cli_dir}/install.ps1"
  chmod +x "${web_cli_dir}/install.sh"
  # Enriched manifest (ADR-018 §C.5): `version` is the contract every older
  # CLI/install script reads; the extra fields drive the version-notify
  # banner (`synaptory version --check`). cli_min_version mirrors plugin.json
  # (bumped together). `critical` flags a security/forced update — set
  # SYNAPTORY_RELEASE_CRITICAL=true on the release to escalate the nag.
  local cli_min released_at notes_url critical
  cli_min=$(sed -n 's/.*"cli_min_version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
    "${REPO_ROOT}/plugin-claude/.claude-plugin/plugin.json" 2>/dev/null | head -n1)
  cli_min="${cli_min:-$ver}"
  released_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  notes_url="https://github.com/h3tech-ai/synaptory-v1/releases/tag/v${ver}"
  case "$(printf '%s' "${SYNAPTORY_RELEASE_CRITICAL:-}" | tr '[:upper:]' '[:lower:]')" in
    1|true|yes|on) critical=true ;;
    *)             critical=false ;;
  esac
  # Checksum-signing cutover (#98): once every published mirror signs
  # sha256sums.txt, set SYNAPTORY_RELEASE_REQUIRE_SIG=true so latest.json
  # advertises signature_required — CLIs then refuse unsigned/unverifiable
  # checksums (fail closed). Default false during rollout so unsigned mirrors
  # keep working. This flag can only STRENGTHEN enforcement client-side.
  local sig_required
  case "$(printf '%s' "${SYNAPTORY_RELEASE_REQUIRE_SIG:-}" | tr '[:upper:]' '[:lower:]')" in
    1|true|yes|on) sig_required=true ;;
    *)             sig_required=false ;;
  esac
  printf '{"version":"%s","cli_min_version":"%s","released_at":"%s","notes_url":"%s","critical":%s,"signature_required":%s}\n' \
    "$ver" "$cli_min" "$released_at" "$notes_url" "$critical" "$sig_required" > "${web_cli_dir}/latest.json"
  echo "  ✓ ${web_cli_dir}/  (latest.json → v${ver}, cli_min ${cli_min}, critical ${critical}, sig_required ${sig_required})"
  echo ""
}

# cmd_deploy — build + deploy. Two targets:
#
#   ./synaptory deploy local
#       1. Run `cmd_build` (ensures every module is fresh).
#       2. Install the CLI binary for this host's OS/arch into ~/.local/bin.
#       3. docker compose -f docker-compose.local.yml up -d (uses IMAGE_TAG
#          from .env, which we rewrite to v<VERSION> first).
#       4. Wait for healthchecks and print verification URLs.
#       Plugin install for local testing uses web/dist/marketplace/ (path
#       transport) or the public GitHub repo after a prod publish.
#
#   ./synaptory deploy prod
#       0. Reclaim disk (docker build cache + unused images >72h) before the
#          build so a near-full root can't abort it mid-way (issue #119).
#          Skip with SYNAPTORY_DEPLOY_NO_PRUNE=1.
#       1. Run `cmd_build`.
#       2. Push images to GHCR (requires GHCR_OWNER + docker login).
#       3. Publish plugin tree to github.com/h3tech-ai/marketplace.
#       4. Publish CLI artifacts to /mnt/pgdata/web-dist/cli/ (filesystem).
#       5. Roll docker-compose.yml forward with IMAGE_TAG=v<VERSION>.
#       6. Healthcheck gate + rollback on failure (delegates to deploy.sh).
#
# Both targets always run a full ./synaptory build first — there is no
# "deploy without build". This is the property that prevents a release
# from shipping with one module stale.
cmd_deploy() {
  local target="${1:-}"
  shift 2>/dev/null || true
  case "$target" in
    local) _deploy_local "$@" ;;
    prod)  _deploy_prod  "$@" ;;
    "")    echo "Usage: ./synaptory deploy {local|prod}" >&2; exit 1 ;;
    *)     echo "Unknown deploy target: $target  (expected: local|prod)" >&2; exit 1 ;;
  esac
}

_deploy_local() {
  # Always rebuild every module first so a deploy can never ship a stale
  # artifact. cmd_build bumps /VERSION (patch) by default; pass --version
  # X.Y.Z (or --minor / --major) before the verb to override.
  #
  # Local vs prod isolation: this path stamps localhost into the CLI as
  # channel=local and writes gitignored hooks/lib/cp-url.local. It installs
  # ~/.local/bin/synaptory-local and never overwrites the prod `synaptory`
  # binary. Runtime SYNAPTORY_CONTROL_PLANE_URL / SYNAPTORY_CP_ENV are ignored.
  local infra_dir="${REPO_ROOT}/infra"
  local compose_file="${infra_dir}/compose/docker-compose.local.yml"
  local env_file="${infra_dir}/compose/.env"

  if [[ ! -f "$env_file" ]]; then
    echo "  copying .env.example → .env"
    cp "${infra_dir}/compose/.env.example" "$env_file"
  fi
  mkdir -p "${infra_dir}/dev-keys" "${infra_dir}/backups"

  local local_url
  local_url="$(_local_stack_url)"
  export SYNAPTORY_CP_URL="${local_url}"
  export SYNAPTORY_CHANNEL=local

  cmd_build "$@"

  local ver
  ver=$(cat "$VERSION_FILE" | tr -d '[:space:]')

  _write_cp_url_local "$local_url"

  echo "──── deploy local (v${ver}) ────"

  # Stamp IMAGE_TAG=v<VERSION> into .env so compose pulls the freshly-built
  # images. Idempotent — if the line already matches, no rewrite.
  _stamp_image_tag "$env_file" "v${ver}"

  # Plugin transport is GitHub (h3tech-ai/marketplace), published on
  # `./synaptory deploy prod`. Local testing uses the dist tree on disk:
  #   /plugin marketplace add ./web/dist/marketplace

  # Bring the stack up. Compose pulls the just-built images by tag.
  echo "  starting compose stack"
  (cd "${REPO_ROOT}/api" && docker_compose -f "$compose_file" --env-file "$env_file" up -d)

  # Wait for at least api+web to be healthy (Caddy depends on web, web on api).
  echo "  waiting for healthchecks..."
  local waited=0
  while [ "$waited" -lt 120 ]; do
    local api_status web_status
    api_status=$(docker_compose -f "$compose_file" --env-file "$env_file" ps api --format json 2>/dev/null)
    web_status=$(docker_compose -f "$compose_file" --env-file "$env_file" ps web --format json 2>/dev/null)
    if echo "$api_status" | grep -q '"Health":"healthy"' \
       && echo "$web_status" | grep -q '"Health":"healthy"'; then
      break
    fi
    sleep 3; waited=$((waited+3))
  done
  if [ "$waited" -ge 120 ]; then
    echo "ERROR: local api/web services did not become healthy within 120 seconds" >&2
    docker_compose -f "$compose_file" --env-file "$env_file" ps >&2 || true
    return 1
  fi

  # Install the CLI to ~/.local/bin for this host's OS/arch. Skip if a
  # binary of the same version is already there (re-deploys don't churn).
  _install_cli_local "$ver"

  local caddy_port
  caddy_port=$(grep -E '^CADDY_HTTP_PORT=' "$env_file" | tail -1 | cut -d= -f2 | tr -d ' "')
  caddy_port="${caddy_port:-8080}"
  echo ""
  echo "=========================================="
  echo "  Local deploy complete — v${ver}"
  echo "=========================================="
  echo "  Web:         http://localhost:${caddy_port}/"
  echo "  API health:  http://localhost:${caddy_port}/healthz"
  echo "  Marketplace: https://github.com/$(_marketplace_github_repo) (prod publish)"
  echo "  Dist tree:   ${REPO_ROOT}/web/dist/marketplace"
  echo "  CLI (local): ${HOME}/.local/bin/synaptory-local  (v${ver}, ${local_url})"
  echo "  CLI (prod):  ~/.local/bin/synaptory left untouched"
  echo "  Plugin URL:  hooks/lib/cp-url.local (gitignored)"
  echo ""
  echo "  Install plugin in Claude Code (local path transport):"
  echo "    /plugin marketplace add ${REPO_ROOT}/web/dist/marketplace"
  echo "    /plugin install ${PLUGIN_NAME}@h3tech-ai"
  echo ""
  echo "  After a prod release, staff install from GitHub:"
  echo "    /plugin marketplace add https://github.com/$(_marketplace_github_repo).git"
  echo ""
}

_deploy_prod() {
  # Reclaim disk BEFORE the build (issues #119, #183). The prod VM's root disk
  # is small and Docker's data-root lives on it; every release builds 5 images
  # (4 production images plus the local-only fixture IdP) +
  # CLI cross-compile, so build cache + old layers + buildx state creep toward
  # full and a release can abort mid-build (1.0.8 died after the api image with
  # 365 MB free; 1.0.16 died at 100% / 332 KB free).
  #
  # #183: the dominant accumulator turned out NOT to be image/build cache but
  # orphaned `buildx_buildkit_builder-*_state` *volumes* — 8.36 GB (99% of
  # reclaimable) on the 1.0.16 cut. `docker builder/image prune` never touch
  # those, so we also drop inactive buildx builders and remove any lingering
  # buildx state volumes by name. The volume reclaim is name-scoped to
  # `buildx_buildkit*` so it can NEVER remove a data volume (postgres / grafana
  # / backup); volumes still attached to a running builder simply error out of
  # `volume rm` and are skipped. Everything here is best-effort and never fails
  # the deploy — rollback re-pulls images from GHCR, so pruned local layers are
  # fine. Skipped when SYNAPTORY_DEPLOY_NO_PRUNE=1. Local dev goes through
  # _deploy_local, so this only runs on the prod path.
  if [[ "${SYNAPTORY_DEPLOY_NO_PRUNE:-}" != "1" ]] && command -v docker >/dev/null 2>&1; then
    echo "──── pre-build disk reclaim (issues #119, #183) ────"
    docker buildx prune -af >/dev/null 2>&1 || true
    docker buildx rm --all-inactive -f >/dev/null 2>&1 || true
    docker volume ls -q --filter name=buildx_buildkit 2>/dev/null \
      | xargs -r docker volume rm >/dev/null 2>&1 || true
    docker image prune -af --filter "until=72h" >/dev/null 2>&1 || true
    df -h / 2>/dev/null | awk 'NR==2{printf "  root fs: %s used, %s free (%s)\n",$3,$4,$5}' || true
  fi

  # Release artifacts are always the canonical stable/prod identity even if
  # the operator previously ran a local build in the same checkout.
  SYNAPTORY_CHANNEL=stable cmd_build "$@"

  local ver
  ver=$(cat "$VERSION_FILE" | tr -d '[:space:]')
  local infra_dir="${REPO_ROOT}/infra"
  local compose_file="${infra_dir}/compose/docker-compose.yml"
  local env_file="${infra_dir}/compose/.env"

  echo "──── deploy prod (v${ver}) ────"

  : "${GHCR_OWNER:?GHCR_OWNER is required for prod deploy (e.g. h3tech-ai)}"

  # 1. Tag + push images to GHCR. Requires `docker login ghcr.io` already done.
  local services=(api web backup git-http)
  for svc in "${services[@]}"; do
    local local_tag="synaptory-${svc}:v${ver}"
    local remote_tag="ghcr.io/${GHCR_OWNER}/synaptory-${svc}:v${ver}"
    docker tag "$local_tag" "$remote_tag"
    echo "  pushing ${remote_tag}"
    docker push "$remote_tag" >/dev/null
  done
  echo "  ✓ images pushed"

  # 2. Publish the same IP-stripped plugin tree to both marketplace transports.
  # GitHub is primary for new installs. The legacy mirror remains mandatory so
  # existing Claude Code users update normally without changing marketplace.
  # Publish GitHub first: if the compatibility mirror then fails, the release
  # stops before CLI/API rollout and existing users remain on the prior version.
  _publish_plugin_to_github
  _publish_plugin_to_legacy

  # 3. Publish CLI artifacts to /mnt/pgdata/web-dist/cli/ only after both
  # marketplace pushes succeeded.
  echo "  publishing CLI → /mnt/pgdata/web-dist/cli/"
  cp -av "${REPO_ROOT}/web/dist/cli/." /mnt/pgdata/web-dist/cli/ >/dev/null

  # 4. Publish single-page user guide.
  local guide_src="${REPO_ROOT}/web/dist/docs/user-guide.html"
  if [ -f "$guide_src" ]; then
    mkdir -p /mnt/pgdata/web-dist/docs/
    cp -f "$guide_src" /mnt/pgdata/web-dist/docs/user-guide.html
  fi

  # 5. Roll compose forward via infra/scripts/deploy.sh.
  #
  # On the prod VM, the canonical checkout is /opt/synaptory (cloud-init
  # creates it). Start with the deploy.sh from the release workspace so a
  # checkout stranded on an older/broken deploy script can still bootstrap.
  # The script fetches main into /opt/synaptory and then re-execs the freshly
  # checked-out copy before changing compose state. REPO_DIR ensures all
  # persistent env/compose paths still resolve under /opt/synaptory.
  #
  # SYNAPTORY_DEPLOY_PROD_REPO_DIR lets a non-standard prod VM layout override
  # the default. Most operators leave it unset.
  local prod_repo_dir="${SYNAPTORY_DEPLOY_PROD_REPO_DIR:-/opt/synaptory}"
  local deploy_sh="${REPO_ROOT}/infra/scripts/deploy.sh"
  if [ -x "$deploy_sh" ] || [ -f "$deploy_sh" ]; then
    REPO_DIR="${prod_repo_dir}" IMAGE_TAG="v${ver}" \
      HEALTH_TIMEOUT_SEC="${HEALTH_TIMEOUT_SEC:-180}" \
      bash "$deploy_sh"
  else
    echo "  skipped compose roll: ${deploy_sh} not present (not on the prod VM)"
    echo "  hint: ensure /opt/synaptory is a checkout of this repo, or"
    echo "        set SYNAPTORY_DEPLOY_PROD_REPO_DIR to override the path."
  fi

  echo ""
  echo "=========================================="
  echo "  Prod deploy complete — v${ver}"
  echo "=========================================="
  echo "  Marketplace: https://github.com/$(_marketplace_github_repo)"
  echo "  CLI:         ${WEB_BASE_URL}/cli/install.sh"
  echo ""
}

# Stamp IMAGE_TAG=<tag> into an .env file in place. Idempotent.
_stamp_image_tag() {
  local env_file="$1" tag="$2"
  if grep -qE '^IMAGE_TAG=' "$env_file"; then
    if ! grep -qE "^IMAGE_TAG=${tag}\$" "$env_file"; then
      _sed_inplace -E "s|^IMAGE_TAG=.*$|IMAGE_TAG=${tag}|" "$env_file"
      echo "  stamped IMAGE_TAG=${tag} in $(basename "$env_file")"
    fi
  else
    echo "IMAGE_TAG=${tag}" >> "$env_file"
    echo "  appended IMAGE_TAG=${tag} to $(basename "$env_file")"
  fi
}

# Local stack URL from compose .env (CADDY_HTTP_PORT, default 8080).
_local_stack_url() {
  local env_file="${REPO_ROOT}/infra/compose/.env"
  local port=8080
  if [[ -f "$env_file" ]]; then
    port=$(grep -E '^CADDY_HTTP_PORT=' "$env_file" | tail -1 | cut -d= -f2 | tr -d ' "' || true)
    port="${port:-8080}"
  fi
  printf 'http://localhost:%s' "$port"
}

# Gitignored per-plugin URL so a source-tree / sideloaded plugin talks to the
# local stack without stamping localhost into committed hooks/lib/cp-url.
_write_cp_url_local() {
  local url="$1"
  local f
  for f in \
    "${REPO_ROOT}/plugin-claude/hooks/lib/cp-url.local" \
    "${REPO_ROOT}/plugin-cursor/hooks/lib/cp-url.local" \
    "${REPO_ROOT}/plugin-codex/plugins/synaptory/hooks/lib/cp-url.local"
  do
    mkdir -p "$(dirname "$f")"
    printf '%s\n' "$url" > "$f"
    echo "  ✓ wrote ${f#"$REPO_ROOT"/}"
  done
}

# Install the local-channel CLI as synaptory-local. Never overwrite the prod
# `synaptory` binary — that mix is what sent prod plugin sessions to localhost.
_install_cli_local() {
  local ver="$1"
  local os arch suffix=""
  case "$(uname -s)" in
    Darwin) os="darwin" ;;
    Linux)  os="linux" ;;
    MINGW*|MSYS*|CYGWIN*) os="windows"; suffix=".exe" ;;
    *) echo "  WARN: unsupported OS $(uname -s) — skip CLI install"; return 0 ;;
  esac
  case "$(uname -m)" in
    arm64|aarch64) arch="arm64" ;;
    x86_64|amd64)  arch="amd64" ;;
    *) echo "  WARN: unsupported arch $(uname -m) — skip CLI install"; return 0 ;;
  esac
  local src="${REPO_ROOT}/web/dist/cli/${ver}/synaptory-${os}-${arch}${suffix}"
  if [ ! -f "$src" ]; then
    echo "  WARN: ${src} not found — skip CLI install"
    return 0
  fi
  local dest="${HOME}/.local/bin/synaptory-local${suffix}"
  mkdir -p "${HOME}/.local/bin"
  install -m 755 "$src" "$dest"
  echo "  ✓ installed local CLI → ${dest}  (v${ver})"
  echo "    prod ~/.local/bin/synaptory was not overwritten"
}

cmd_dev() {
  case "${1:-}" in
    cli)
      shift
      local url="${SYNAPTORY_CP_URL:-$(_local_stack_url)}"
      (cd "${REPO_ROOT}/cli" && go run -ldflags \
        "-X github.com/h3tech-ai/synaptory-v1/cli/internal/cli.ControlPlaneURL=${url} -X github.com/h3tech-ai/synaptory-v1/cli/internal/cli.Channel=local" \
        ./cmd/synaptory "$@")
      ;;
    plugin)
      shift
      # Authored source stays host-neutral ({{read:}} / {{include:}}). Dist
      # expands those; a raw --plugin-dir would ship the literals into the
      # live prompt. Expand into a staging copy the same way the marketplace
      # package is produced.
      local staging
      staging=$(mktemp -d "${TMPDIR:-/tmp}/synaptory-dev-plugin.XXXXXX")
      rsync -aL --exclude='__pycache__' --exclude='*.pyc' --exclude='tests/' \
        "${PLUGIN_ROOT}/" "${staging}/"
      if ! python3 "${REPO_ROOT}/core/scripts/expand_claude_directives.py" "$staging"; then
        echo "ERROR: directive expansion failed for ./synaptory dev plugin" >&2
        rm -rf "$staging"
        exit 1
      fi
      echo "  Launching: claude --plugin-dir ${staging} $*  (directives expanded)"
      exec claude --plugin-dir "${staging}" "$@"
      ;;
    *) echo "Usage: $0 dev {cli|plugin} [args…]" >&2; exit 1 ;;
  esac
}

cmd_cli() {
  # CLI dev helpers. The `build` subcommand is gone — `./synaptory build` builds
  # the CLI as part of the unified build.
  local cli_dir="${REPO_ROOT}/cli"
  case "${1:-}" in
    test)
      (cd "$cli_dir" && go test ./... "${@:2}")
      ;;
    smoke)
      "${cli_dir}/scripts/cli-smoke.sh"
      ;;
    run)
      shift
      local url="${SYNAPTORY_CP_URL:-$(_local_stack_url)}"
      (cd "$cli_dir" && go run -ldflags \
        "-X github.com/h3tech-ai/synaptory-v1/cli/internal/cli.ControlPlaneURL=${url} -X github.com/h3tech-ai/synaptory-v1/cli/internal/cli.Channel=local" \
        ./cmd/synaptory "$@")
      ;;
    build)
      echo "ERROR: 'crew cli build' is removed. Use './synaptory build' (builds the CLI as part of the unified build)." >&2
      exit 1
      ;;
    *) echo "Usage: $0 cli {test|smoke|run [args...]}" >&2; exit 1 ;;
  esac
}

cmd_api() {
  # Lifecycle verbs against the running compose stack.
  # `up` is intentionally absent — use `./synaptory deploy local` (or `deploy prod`)
  # to (re)build everything and bring the stack up in one step.
  local cp_dir="${REPO_ROOT}/api"
  local infra_dir="${REPO_ROOT}/infra"
  local compose_file="${infra_dir}/compose/docker-compose.local.yml"
  local compose_args=(-f "$compose_file" --env-file "${infra_dir}/compose/.env")

  case "${1:-}" in
    down)
      shift
      (cd "$cp_dir" && docker_compose "${compose_args[@]}" down "$@")
      ;;
    logs)
      shift
      (cd "$cp_dir" && docker_compose "${compose_args[@]}" logs -f "$@")
      ;;
    ps)
      (cd "$cp_dir" && docker_compose "${compose_args[@]}" ps)
      ;;
    migrate)
      (cd "$cp_dir" && docker_compose "${compose_args[@]}" run --rm --entrypoint "" api \
        alembic upgrade head)
      ;;
    backup)
      (cd "$cp_dir" && docker_compose "${compose_args[@]}" run --rm backup \
        /usr/local/bin/backup.sh --run-once)
      ;;
    smoke)
      local caddy_port="8080"
      if [[ -f "${infra_dir}/compose/.env" ]]; then
        caddy_port=$(grep -E '^CADDY_HTTP_PORT=' "${infra_dir}/compose/.env" | tail -1 | cut -d= -f2 | tr -d ' "')
        caddy_port="${caddy_port:-8080}"
      fi
      CP_URL="http://localhost:${caddy_port}" "${infra_dir}/smoke/run-all.sh"
      ;;
    test)
      (cd "$cp_dir" && python3 -m pytest tests -q)
      ;;
    projects)
      shift
      cmd_api_projects "$cp_dir" "$compose_file" "$@"
      ;;
    up)
      echo "ERROR: 'crew api up' is removed. Use './synaptory deploy local' (or 'deploy prod')." >&2
      exit 1
      ;;
    *) echo "Usage: $0 api {down|logs [service]|ps|migrate|backup|smoke|test|projects ...}" >&2; exit 1 ;;
  esac
}

# V1.5.E: operator-side project admin verbs. Shells out to the FastAPI admin
# CLI inside the api container (which runs with DB creds already wired up).
cmd_api_projects() {
  local cp_dir="$1"; shift
  local compose_file="$1"; shift
  local infra_dir="${REPO_ROOT}/infra"
  local compose_args=(-f "$compose_file" --env-file "${infra_dir}/compose/.env")
  local sub="${1:-}"; shift 2>/dev/null || true
  case "$sub" in
    create)
      local slug="${1:-}"; local name="${2:-$slug}"; local admin="${3:-}"
      if [[ -z "$slug" || -z "$admin" ]]; then
        echo "Usage: $0 api projects create <slug> <name> <initial-admin-upn> [--baa] [--policy-profile <id>]" >&2
        exit 1
      fi
      shift 3 2>/dev/null || true
      (cd "$cp_dir" && docker_compose "${compose_args[@]}" exec -T api \
        python -m synaptory_api.admin.projects create --slug "$slug" --name "$name" \
          --initial-admin "$admin" "$@")
      ;;
    add-member)
      local slug="${1:-}"; local upn="${2:-}"; local role="${3:-member}"
      if [[ -z "$slug" || -z "$upn" ]]; then
        echo "Usage: $0 api projects add-member <slug> <upn> [role]" >&2; exit 1
      fi
      (cd "$cp_dir" && docker_compose "${compose_args[@]}" exec -T api \
        python -m synaptory_api.admin.projects add-member --slug "$slug" --upn "$upn" --role "$role")
      ;;
    revoke)
      local slug="${1:-}"; local upn="${2:-}"
      if [[ -z "$slug" || -z "$upn" ]]; then
        echo "Usage: $0 api projects revoke <slug> <upn>" >&2; exit 1
      fi
      (cd "$cp_dir" && docker_compose "${compose_args[@]}" exec -T api \
        python -m synaptory_api.admin.projects revoke --slug "$slug" --upn "$upn")
      ;;
    list)
      (cd "$cp_dir" && docker_compose "${compose_args[@]}" exec -T api \
        python -m synaptory_api.admin.projects list)
      ;;
    *) echo "Usage: $0 api projects {create|list|add-member|revoke}" >&2; exit 1 ;;
  esac
}

cmd_release() {
  echo "ERROR: 'crew release' is removed. The unified flow is:" >&2
  echo "  ./synaptory build              # build every module at the new /VERSION" >&2
  echo "  ./synaptory deploy local       # bring up local stack" >&2
  echo "  ./synaptory deploy prod        # ship to production (requires GHCR creds + prod-VM context)" >&2
  exit 1
}

cmd_conformance() {
  # The cross-host conformance contract, plus its generated report.
  # Always -c: there is no repo-root pytest config, so a bare invocation
  # resolves rootdir upward and silently drops --strict-markers.
  local report=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --report) report="${2:-docs/v1.0/conformance-report.md}"; [ -n "${2:-}" ] && shift ;;
      *) ;;
    esac
    shift
  done
  cd "$REPO_ROOT" || exit 1
  if [ -n "$report" ]; then
    python3 -m pytest -c conformance/pytest.ini conformance -q --no-header \
      "--conformance-report=$report"
  else
    python3 -m pytest -c conformance/pytest.ini conformance -q --no-header
  fi
}

cmd_e2e() {
  # Cross-module end-to-end harness. See docs/BRD.md §11 + e2e/README.md.
  #
  # Brings up the local control-plane stack, runs e2e/run-e2e.sh against it,
  # then unconditionally tears the stack down (via trap) so a failed test
  # never leaves a stack running. Pass --keep-stack to skip teardown.
  local keep_stack=false
  local scenario=""
  local marker=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --keep-stack) keep_stack=true; shift ;;
      --scenario) scenario="$2"; shift 2 ;;
      --smoke) marker="smoke"; shift ;;
      --marker) marker="$2"; shift 2 ;;
      --help|-h)
        cat <<'USAGE'
Usage: ./synaptory e2e [--keep-stack] [--scenario test_NN_name.py | --smoke | --marker EXPR]

Drives the cross-module end-to-end harness against a fresh local stack.
See docs/BRD.md §11 for the full scenario catalogue and FR coverage map.
USAGE
        return 0
        ;;
      *) echo "Unknown flag: $1" >&2; return 1 ;;
    esac
  done

  if [[ -n "$scenario" && -n "$marker" ]]; then
    echo "--scenario and --smoke/--marker are mutually exclusive" >&2
    return 1
  fi

  # E2E exercises the real exchange + refresh endpoints without contacting
  # Entra. The local compose file includes a fixture IdP, but normal local
  # development may still point at a real tenant through compose/.env. Export
  # explicit test-only overrides so Docker Compose configures the API and IdP
  # with one matching issuer, audience, and group vocabulary.
  export SYNAPTORY_CP_ENTRA_ISSUER="http://fixture-idp:9000"
  export SYNAPTORY_CP_ENTRA_JWKS_URL="http://fixture-idp:9000/.well-known/jwks.json"
  export SYNAPTORY_CP_ENTRA_USERS_GROUP="synaptory-users"
  export SYNAPTORY_CP_ENTRA_ADMINS_GROUP="synaptory-admins"
  export FIXTURE_URL="http://localhost:9000"

  # The web Playwright specs need a real signed-in session: the console pages
  # redirect to /auth/login without one, so unauthenticated runs fail with
  # "unexpected value .../auth/login" rather than testing anything. The
  # fixture IdP mints API tokens but cannot produce the web app's iron-session
  # COOKIE, so the local-credential path is what a browser can actually drive.
  #
  # Test-only, and local-stack-only by construction: both flags default to
  # false everywhere else, and `deploy prod` never sets them.
  export SYNAPTORY_CP_LOCAL_AUTH_ENABLED="true"
  export SYNAPTORY_LOCAL_AUTH_ENABLED="true"
  export SYNAPTORY_CP_LOCAL_ADMIN_UPN="${SYNAPTORY_CP_LOCAL_ADMIN_UPN:-admin@h3t.co}"
  export SYNAPTORY_CP_LOCAL_ADMIN_PASSWORD="${SYNAPTORY_CP_LOCAL_ADMIN_PASSWORD:-e2e-local-admin}"
  export SYNAPTORY_CP_LOCAL_USER_UPN="${SYNAPTORY_CP_LOCAL_USER_UPN:-user@h3t.co}"
  export SYNAPTORY_CP_LOCAL_USER_PASSWORD="${SYNAPTORY_CP_LOCAL_USER_PASSWORD:-e2e-local-user}"

  local infra_dir="${REPO_ROOT}/infra"
  local compose_file="${infra_dir}/compose/docker-compose.local.yml"
  local compose_args=(-f "$compose_file" --env-file "${infra_dir}/compose/.env")

  _e2e_teardown() {
    # `keep_stack` is `local`-scoped to cmd_e2e; the EXIT trap may fire
    # after the function returns (or before the variable is set, if the
    # arg parser bails first under `set -u`). Default-substitute so the
    # trap is robust to either timing.
    if [[ "${keep_stack:-false}" == "true" ]]; then
      echo "[e2e] --keep-stack set; leaving stack up. Use './synaptory api down -v' when done."
      return 0
    fi
    echo "[e2e] tearing down local stack"
    (cd "${REPO_ROOT}/api" && docker_compose "${compose_args[@]}" down -v) || true
  }
  trap _e2e_teardown EXIT INT TERM

  echo "[e2e] bringing up local stack"
  # Keep this as a simple command. Wrapping a Bash function in `||` disables
  # errexit throughout that function, which previously let failed Docker
  # builds continue and report a false successful build.
  # E2E is verification, not a release. A normal local deploy intentionally
  # patch-bumps VERSION, so pin this build to the current value to keep a test
  # run from modifying tracked release manifests.
  cmd_deploy local --version "$CURRENT_VERSION"

  echo "[e2e] running scenarios"
  if [[ -n "$scenario" ]]; then
    E2E_SCENARIO="$scenario" "${REPO_ROOT}/e2e/run-e2e.sh"
  elif [[ -n "$marker" ]]; then
    E2E_MARKER="$marker" "${REPO_ROOT}/e2e/run-e2e.sh"
  else
    "${REPO_ROOT}/e2e/run-e2e.sh"
  fi
}

cmd_help() {
  cat <<'HELP'

  synaptory admin CLI

  Usage: ./synaptory <command> [arguments]

  Required env vars (read from .env or .envrc at the repo root):
    SYNAPTORY_CP_URL=https://...        Control-plane URL stamped into the plugin
                                   and CLI binary at build time.
    SYNAPTORY_CP_ENTRA_TENANT_ID=...    Entra tenant for OAuth login.
    SYNAPTORY_CP_ENTRA_CLIENT_ID=...    Entra application (client) ID.

  Optional env vars:
    SYNAPTORY_WEB_BASE_URL=https://...  Self-hosted base URL (default synaptory.h3t.co).
    GHCR_OWNER=h3tech-ai           GitHub org for image registry (deploy prod).

  Commands:
    build [--minor|--major|--version X.Y.Z]
                                 Build EVERY module at the new /VERSION:
                                   1. Docker images: api, web, fixture-idp (local only), backup, git-http
                                      (tagged synaptory-<svc>:v<VERSION>)
                                   2. CLI binaries (5 OS/arch into cli/dist/)
                                   3. CLI staged into web/dist/cli/<VERSION>/
                                   4. Plugin tree into web/dist/marketplace/

    deploy local                 Build, then bring up the local docker-compose
                                 stack and install the CLI to ~/.local/bin.
                                 Plugin install uses ./web/dist/marketplace
                                 (GitHub publish happens on deploy prod).

    deploy prod                  Build, then push images to GHCR, publish the
                                 plugin tree to github.com/h3tech-ai/marketplace,
                                 ship CLI artifacts to /mnt/pgdata/web-dist/cli/,
                                 and roll the prod compose stack forward with
                                 healthcheck gate + rollback. Run on the prod VM
                                 (self-hosted runner).

    version [bump_type]          Show or bump /VERSION without building.
    status                       Source vs live-marketplace version state.
    test                         Plugin syntax + pytest (Layer 1 + Layer 2).
    dev plugin                   Launch `claude --plugin-dir plugin-claude`.
    dev cli                      Run CLI against a local control-plane.
    cli {test|smoke|run}         CLI dev helpers (go test, e2e, go run).
    api {down|logs|ps|migrate|backup|smoke|test|projects ...}
                                 Lifecycle ops on the running compose stack
                                 (use `deploy local` to start it).
    e2e [--keep-stack] [--scenario test_NN_name.py]
    conformance [--report [path]]
                                 Cross-module end-to-end harness against a
                                 fresh local stack.
    help                         Show this help message.

  Examples:
    ./synaptory build                         # patch bump, build all 4 modules
    ./synaptory build --minor                 # minor bump
    ./synaptory build --version 3.0.0         # explicit version
    ./synaptory deploy local                  # build + start local stack
    ./synaptory deploy prod                   # build + ship to production

HELP
}

# ── Dispatch ───────────────────────────────────────────────────────────────────

COMMAND="${1:-help}"
shift 2>/dev/null || true

case "$COMMAND" in
  build)        cmd_build "$@" ;;
  deploy)       cmd_deploy "$@" ;;
  version)      cmd_version "$@" ;;
  status)       cmd_status "$@" ;;
  test)         cmd_test "$@" ;;
  dev)          cmd_dev "$@" ;;
  cli)          cmd_cli "$@" ;;
  api)          cmd_api "$@" ;;
  release)      cmd_release "$@" ;;
  e2e)          cmd_e2e "$@" ;;
  conformance)  cmd_conformance "$@" ;;
  help|--help|-h) cmd_help ;;
  *) echo "Unknown command: $COMMAND (run: ./synaptory help)" >&2; exit 1 ;;
esac
