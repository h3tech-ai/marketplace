  echo "  ──────────────────────────────"
  echo ""

  # Source
  local skill_count=$(find "$PLUGIN_ROOT/skills" -name "SKILL.md" -not -path "*/_shared/*" 2>/dev/null | wc -l | tr -d ' ')
  local protocol_count=$(find "$PLUGIN_ROOT/skills/_shared/protocols" -name "*.md" 2>/dev/null | wc -l | tr -d ' ')
  local hook_count=$(find "$PLUGIN_ROOT/hooks" -name "*.sh" 2>/dev/null | wc -l | tr -d ' ')
  echo "  Source (plugin-claude/)"
