#
# Synaptory admin CLI
#
# Single build, single deploy. Two verbs:
#
#   ./synaptory build [--minor|--major|--version X.Y.Z]
#       Build EVERY module (plugin tree + CLI binaries + api/web/fixture-idp/backup/git-http
#       Docker images), all tagged with the same /VERSION. No partial builds.
#
#   ./synaptory deploy {local|prod}
#       Build, then deploy. `local` brings up docker-compose on this machine
#       and installs ~/.local/bin/synaptory-local (never overwrites prod
#       `synaptory`). `prod` pushes images to GHCR,
#       publishes the plugin tree to github.com/h3tech-ai/marketplace and the
#       legacy synaptory.h3t.co compatibility mirror, ships CLI artifacts to
#       /mnt/pgdata/web-dist/cli/, and rolls compose forward.
#
# Inspection / dev helpers:
#   ./synaptory version [patch|minor|major|X.Y.Z]     Show or bump /VERSION.
#   ./synaptory status                                 Source vs published marketplace.
#   ./synaptory test                                   Syntax + pytest.
#   ./synaptory dev {plugin|cli}                       Run plugin-claude/CLI against a local CP.
#   ./synaptory api {down|logs|ps|migrate|backup|test|projects ...}
#                                                 Lifecycle ops on the running stack
#                                                 (use ./synaptory deploy local to start it).
#   ./synaptory e2e [--keep-stack] [--scenario ...]    Cross-module harness.
#   ./synaptory conformance [--report [path]]         Cross-host contract + report.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# Prefer `docker compose` (plugin, v2) over standalone `docker-compose`.
docker_compose() {
  if docker compose version &>/dev/null 2>&1; then
    docker compose "$@"
  else
    docker-compose "$@"
  fi
}

# Auto-load repo-root env file (signing seeds, SYNAPTORY_CP_URL, SYNAPTORY_PLUGIN_NAME,
# etc.). Supports both .env and .envrc — .env wins when both exist. Both are
# sourced as plain shell, so they must stick to `export KEY=value` lines.
# Existing environment wins over either file.
for _env_file in "${REPO_ROOT}/.env" "${REPO_ROOT}/.envrc"; do
  if [[ -f "$_env_file" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$_env_file"
    set +a
    break
  fi
done
unset _env_file

PLUGIN_ROOT="${REPO_ROOT}/plugin-claude"
# VERSION lives at the repo root so the plugin and the Go CLI share a single
# source of truth. Bumped by `./synaptory build` and stamped into both the plugin
# (plugin.json, marketplace entry) and the CLI binary (ldflags). The admin
# API / UI version independently — they're operator-side services, not part
# of what staff install.
VERSION_FILE="${REPO_ROOT}/VERSION"
PLUGIN_JSON="${PLUGIN_ROOT}/.claude-plugin/plugin.json"
CURSOR_PLUGIN_JSON="${REPO_ROOT}/plugin-cursor/.cursor-plugin/plugin.json"
CODEX_PLUGIN_JSON="${REPO_ROOT}/plugin-codex/plugins/synaptory/.codex-plugin/plugin.json"
USER_GUIDE_BUILDER="${REPO_ROOT}/plugin-claude/scripts/build_user_guide.py"
# Control Plane + CLI download base URL. GitHub (h3tech-ai/marketplace) is the
# primary marketplace for new installs. The legacy synaptory.h3t.co catalog is
# still published as a compatibility mirror for existing Claude Code users.
# Override SYNAPTORY_WEB_BASE_URL for staging.
WEB_BASE_URL="${SYNAPTORY_WEB_BASE_URL:-https://synaptory.h3t.co}"

# PLUGIN_NAME is the marketplace entry name. v3 retires the transitional
# "synaptory-next" channel and consolidates back to a single canonical
# name "synaptory". The channel-aware CLI infra (SYNAPTORY_CHANNEL ldflag,
# ~/.synaptory-<channel>/ paths, per-channel keychain entries) remains in
# place as latent capability — set SYNAPTORY_PLUGIN_NAME + SYNAPTORY_CHANNEL together
# if a future migration needs another side-by-side pilot. Default:
PLUGIN_NAME="${SYNAPTORY_PLUGIN_NAME:-synaptory}"

# Published catalog layout. Every host gets plugins/<host>/ so the three
# packages in the marketplace repo share one convention; the per-host catalog
# manifests (.claude-plugin/, .cursor-plugin/, .agents/plugins/) stay where
# each host requires them. Plugin *name* stays PLUGIN_NAME on every host —
# that is the stable install identifier, so moving these dirs does not break
# existing installs.
DIST_CLAUDE_SUBDIR="plugins/claude"
DIST_CURSOR_SUBDIR="plugins/cursor"
DIST_CODEX_SUBDIR="plugins/codex"
# Pre-consolidation locations, removed on build so the --delete publish
# cannot ship both layouts at once.
DIST_LEGACY_SUBDIRS=("${PLUGIN_NAME}" "plugin-cursor" "plugins/synaptory")

CURRENT_VERSION=$(cat "$VERSION_FILE" 2>/dev/null | tr -d '[:space:]' || echo "0.0.0")

# ── Helpers ────────────────────────────────────────────────────────────────────

encrypt_file() {
  # AES-256-CBC + PBKDF2 — same parameters as the legacy
  # access_token_manager.encrypt entrypoint, inlined here so the plugin
  # doesn't have to ship a Python crypto module to perform a build-time
  # operation. Args: <master_password> <input_path> <output_path>.
  openssl enc -aes-256-cbc -salt -pbkdf2 -iter 100000 \
    -in "$2" -out "$3" -pass "pass:$1" >/dev/null
}

extract_frontmatter() {
  awk '/^---$/{if(++c==2)exit}c' "$1"
}

generate_stub() {
  local skill_name="$1" original_file="$2"
  local fm stub_cli stub_state
  fm=$(extract_frontmatter "$original_file")
  case "${SYNAPTORY_CHANNEL:-}" in
    local) stub_cli="synaptory-local"; stub_state=".synaptory-local" ;;
    ""|stable) stub_cli="synaptory"; stub_state=".synaptory" ;;
    *) stub_cli="synaptory-${SYNAPTORY_CHANNEL}"; stub_state=".synaptory-${SYNAPTORY_CHANNEL}" ;;
  esac
  # Stub resolution order:
  #   1. The build channel's CLI on PATH — \`synaptory\` for production or
  #      \`synaptory-local\` for a local package. ADR-008: the CLI no longer
  #      ships bundled in the plugin.
  #   2. The same channel's cached .plugin-root pointer, written by
  #      SessionStart when the plugin loads. Used when the CLI is not on PATH
  #      but the skill stub needs
  #      to call into the plugin's decrypt hook directly (e.g. mid-session
  #      after the SessionStart handshake completed but before the user
  #      restarts their terminal).
  # We intentionally do NOT use \${CLAUDE_SKILL_DIR} or \${CLAUDE_PLUGIN_ROOT}
  # in the stub body — Claude Code does not reliably expand those in \`!bash\`
  # inline commands today (see anthropics/claude-code#9354, #48230).
  cat <<STUB
${fm}
allowed-tools: Bash(bash -c *synaptory*)
---

# ${skill_name}

!\`bash -c 'if command -v ${stub_cli} >/dev/null 2>&1; then ${stub_cli} skills get "${skill_name}" && exit 0; fi; f="\$HOME/${stub_state}/.plugin-root"; if [ -r "\$f" ]; then pr="\$(cat "\$f")"; if [ -x "\$pr/hooks/synaptory-decrypt-skill.sh" ]; then exec bash "\$pr/hooks/synaptory-decrypt-skill.sh" "${skill_name}"; fi; fi; echo "synaptory: ${stub_cli} is not on PATH and the ${stub_state} plugin root is not cached." >&2; exit 1'\`
STUB
}

bump_version() {
  local bump_type="${1:-patch}" explicit=""
  if echo "$bump_type" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+$'; then
    explicit="$bump_type"
  fi

  IFS='.' read -r V_MAJ V_MIN V_PAT <<< "$CURRENT_VERSION"

  if [ -n "$explicit" ]; then
    echo "$explicit"
  elif [ "$bump_type" = "major" ]; then
    echo "$((V_MAJ + 1)).0.0"
  elif [ "$bump_type" = "minor" ]; then
    echo "${V_MAJ}.$((V_MIN + 1)).0"
  else
    echo "${V_MAJ}.${V_MIN}.$((V_PAT + 1))"
  fi
}

# Portable in-place sed: BSD `sed -i ''` and GNU `sed -i` are mutually
# incompatible (BSD treats `''` as the backup suffix, GNU treats it as a
# filename). Use the `.bak`-then-remove dance which works under both.
_sed_inplace() {
  sed -i.bak "$@"
  # Remove every .bak alongside the file(s) sed touched. The file argument
  # is always the last positional; pluck it back off the call site.
  for arg in "$@"; do :; done
  [[ -f "${arg}.bak" ]] && rm -f "${arg}.bak"
}

write_version() {
  local ver="$1"
  echo "$ver" > "$VERSION_FILE"
  if [[ -d "${REPO_ROOT}/plugin-cursor" ]]; then
    echo "$ver" > "${REPO_ROOT}/plugin-cursor/VERSION"
  fi
  if [[ -d "${REPO_ROOT}/plugin-codex" ]]; then
    echo "$ver" > "${REPO_ROOT}/plugin-codex/VERSION"
  fi
  _stamp_plugin_json() {
    local json_path="$1"
    if [ -f "$json_path" ]; then
      # Bump both "version" and "cli_min_version" when the field exists.
      _sed_inplace "s/\"version\": \"[0-9]*\.[0-9]*\.[0-9]*\"/\"version\": \"$ver\"/" "$json_path"
      if grep -q '"cli_min_version"' "$json_path" 2>/dev/null; then
        _sed_inplace "s/\"cli_min_version\": \"[0-9]*\.[0-9]*\.[0-9]*\"/\"cli_min_version\": \"$ver\"/" "$json_path"
      fi
    fi
  }
  _stamp_plugin_json "$PLUGIN_JSON"
  _stamp_plugin_json "$CURSOR_PLUGIN_JSON"
  _stamp_plugin_json "$CODEX_PLUGIN_JSON"
}

# Re-compose the Cursor host plugin so generated files stay at /VERSION.
# Authored overlay (hooks.json, MCP, Cursor SKILL.md) is never overwritten.
_compose_cursor_plugin() {
  echo "──── plugin-cursor compose ────"
  local compose="${REPO_ROOT}/plugin-cursor/scripts/compose.sh"
  if [[ ! -x "$compose" && -f "$compose" ]]; then
    chmod +x "$compose"
  fi
  if [[ ! -f "$compose" ]]; then
    echo "ERROR: $compose not found — cannot compose plugin-cursor." >&2
    exit 1
  fi
  bash "$compose" || exit 1
  # Never stamp SYNAPTORY_CP_URL into the source tree. compose.py writes the
  # committed marketplace default; local testing uses gitignored cp-url.local.
  # The build URL is applied to the published copy in _package_cursor_marketplace.
  _package_cursor_marketplace
}

# Copy plugin-cursor into the published marketplace tree and stub IP bodies
# the same way Claude's dist stubs SKILL.md / agent.md (ADR-016). The private
# working tree keeps full SKILL.md for seed + source-tree dev. Public
# marketplace clones must never receive that copy.
_package_cursor_marketplace() {
  local marketplace_dir="${REPO_ROOT}/web/dist/marketplace"
  local src="${REPO_ROOT}/plugin-cursor"
  local dest="${marketplace_dir}/${DIST_CURSOR_SUBDIR}"
  local catalog_src="${REPO_ROOT}/.cursor-plugin/marketplace.json"
  local catalog_dest="${marketplace_dir}/.cursor-plugin/marketplace.json"
  echo "──── plugin-cursor marketplace package ────"
  mkdir -p "$dest"
  rsync -a --delete \
    --exclude '__pycache__' --exclude '*.pyc' --exclude 'tests' \
    --exclude '.pytest_cache' \
    "$src/" "$dest/"
  python3 "${src}/scripts/compose.py" --strip-ip --out "$dest" || exit 1
  if [[ -n "${SYNAPTORY_CP_URL:-}" ]]; then
    printf '%s\n' "${SYNAPTORY_CP_URL}" > "${dest}/hooks/lib/cp-url"
    echo "  Stamped Cursor control-plane URL → ${dest#"$REPO_ROOT"/}/hooks/lib/cp-url"
  fi
  mkdir -p "$(dirname "$catalog_dest")"
  cp -f "$catalog_src" "$catalog_dest"
  echo "  Cursor plugin → ${dest} (IP-stripped)"
  echo "  Cursor catalog → ${catalog_dest}"
}

# Validate and assemble the Codex host package into the same marketplace root.
# The Codex catalog lives at .agents/plugins/ and resolves ./plugins/synaptory
# from the marketplace root.
_compose_codex_plugin() {
  echo "──── plugin-codex compose ────"
  local compose="${REPO_ROOT}/plugin-codex/scripts/compose.py"
  local marketplace_dir="${REPO_ROOT}/web/dist/marketplace"
  local output="${marketplace_dir}/${DIST_CODEX_SUBDIR}"
  local catalog_src="${REPO_ROOT}/plugin-codex/.agents/plugins/marketplace.json"
  local catalog_dest="${marketplace_dir}/.agents/plugins/marketplace.json"
  if [[ ! -f "$compose" ]]; then
    echo "  skipped (plugin-codex not in this tree)"
    return 0
  fi
  python3 "$compose" \
    --out "$output" \
    --control-plane-url "${SYNAPTORY_CP_URL}" || exit 1
  mkdir -p "$(dirname "$catalog_dest")"
  cp -f "$catalog_src" "$catalog_dest"
  echo "  Codex catalog → ${catalog_dest}"
}

# ── Commands ───────────────────────────────────────────────────────────────────

cmd_build() {
  # Unified build: every invocation builds all runtime images and packages so
  # a release
  # never ships with one module stale. No sub-targets, no skip flags.
  #
  #   1. Bump /VERSION (patch unless --minor/--major/--version overrides).
  #   2. Build Docker images for api, web, fixture-idp, backup, git-http — tagged
  #      `synaptory-<svc>:v<VERSION>` (the same compose IMAGE_TAG used by
  #      both local and prod stacks).
  #   3. Cross-compile the CLI for 5 OS/arch pairs into cli/dist/.
  #   4. Stage CLI binaries + sha256sums + install scripts + latest.json
  #      into web/dist/cli/<VERSION>/  (no `v` prefix — the existing
  #      install.sh + `synaptory update` clients fetch /cli/<version>/).
  #   5. Package the plugin tree (stub generation, integrity manifest,
  #      marketplace.json update) into web/dist/marketplace/<PLUGIN_NAME>/.
  #   6. Re-compose plugin-cursor/ from plugin-claude/ so the Cursor host stays at
  #      the same /VERSION (GENERATED files; authored overlay is kept).
  #   7. Validate and assemble plugin-codex into the shared marketplace root.
  #
  # Publish + deploy are NOT done here — see `./synaptory deploy {local|prod}`.

  if [[ -z "${SYNAPTORY_CP_URL:-}" ]]; then
    echo "ERROR: SYNAPTORY_CP_URL is required to build." >&2
    echo "  export SYNAPTORY_CP_URL=https://your-control-plane-host" >&2
    exit 1
  fi
  if [[ -z "${SYNAPTORY_CP_ENTRA_TENANT_ID:-}" || -z "${SYNAPTORY_CP_ENTRA_CLIENT_ID:-}" ]]; then
    echo "ERROR: SYNAPTORY_CP_ENTRA_TENANT_ID and SYNAPTORY_CP_ENTRA_CLIENT_ID are required." >&2
    echo "  Without these stamped into the CLI, staff login fails on first run." >&2
    exit 1
  fi

  local bump_type="patch" explicit_ver=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --minor) bump_type="minor"; shift ;;
      --major) bump_type="major"; shift ;;
      --version) explicit_ver="$2"; shift 2 ;;
      *) echo "Unknown option: $1 (run: ./synaptory help)" >&2; exit 1 ;;
    esac
  done

  local new_ver
  if [ -n "$explicit_ver" ]; then
    new_ver="$explicit_ver"
  else
    new_ver=$(bump_version "$bump_type")
  fi
  write_version "$new_ver"

  echo "=========================================="
  echo "  synaptory build — v${CURRENT_VERSION} → v${new_ver}"
  echo "=========================================="
  echo ""

  # SYNAPTORY_BUILD_SKIP_HEAVY=1 skips docker + CLI builds. Used only by the
  # plugin-tree unit tests (plugin-claude/tests/build/) which exercise stub
  # generation + integrity manifest contents and shouldn't pay the
  # cost of full image builds or Go cross-compilation. Not a user-facing
  # flag — runners that need a real build never set this.
  if [[ "${SYNAPTORY_BUILD_SKIP_HEAVY:-}" != "1" ]]; then
    _build_docker_images "$new_ver"   # 1/4 — runtime images :v<VERSION>
    _build_cli_binaries "$new_ver"    # 2/4 — Go cross-compile 5 OS/arch
    _stage_cli_to_dist  "$new_ver"    # 3/4 — web/dist/cli/<VERSION>/
  fi
  _build_plugin_tree "$new_ver"       # 4/6 — web/dist/marketplace/<plugin>/
  _compose_cursor_plugin              # 5/6 — plugin-cursor/ from plugin-claude/
  _compose_codex_plugin               # 6/6 — marketplace/plugins/synaptory/
}

# _build_plugin_tree: packages the plugin into web/dist/marketplace/.
# Called by cmd_build. Operates on the version passed in (does NOT bump).
_build_plugin_tree() {
  local new_ver="$1"
  echo "──── plugin tree ────"

  # ADR-008: the CLI does NOT ship bundled inside the plugin distribution.
  # The plugin carries a stamped CP URL and its hooks; staff install the
  # CLI once via the marketplace install script. The unified ./synaptory build
  # produces both — they share /VERSION and ship together via deploy.

  # Stamp control-plane URL into the plugin at build time.
  # Staff cannot override this — the URL is an operator constant, not a variable.
  local cp_url_file="${PLUGIN_ROOT}/hooks/lib/cp-url"
  if [[ ! -f "$cp_url_file" ]]; then
    echo "ERROR: ${cp_url_file} not found — cannot stamp control-plane URL." >&2
    exit 1
  fi
  echo "${SYNAPTORY_CP_URL}" > "$cp_url_file"
  echo "  Stamped control-plane URL → hooks/lib/cp-url"

  # ── Prepare marketplace working directory (self-hosted, no GitHub) ──────
  # `web/dist/marketplace/` is the canonical output: Caddy on the control
  # plane bind-mounts it (or a copy of it on the prod host) and serves the
  # contents directly at /marketplace/*. The directory persists between
  # builds so prior plugin entries in marketplace.json are preserved.
  local marketplace_dir="${REPO_ROOT}/web/dist/marketplace"
  mkdir -p "${marketplace_dir}/.claude-plugin"

  # Always restore the placeholder on exit so the source tree stays clean.
  trap "echo 'SYNAPTORY_CP_URL_PLACEHOLDER' > '${cp_url_file}'" EXIT

  # Ensure marketplace.json exists — initialise empty registry on first build.
  if [[ ! -f "${marketplace_dir}/.claude-plugin/marketplace.json" ]]; then
    cat > "${marketplace_dir}/.claude-plugin/marketplace.json" <<'INIT'
{
  "name": "h3tech-ai",
  "owner": {
    "name": "H3Tech Inc."
  },
  "plugins": []
}
INIT
    echo "  Initialised empty marketplace.json"
  fi
  # Drop pre-consolidation plugin dirs. The publish rsyncs with --delete, so
  # leaving them here would push two copies of every host package to the
  # public catalog.
  for legacy in "${DIST_LEGACY_SUBDIRS[@]}"; do
    if [[ -d "${marketplace_dir}/${legacy}" ]]; then
      rm -rf "${marketplace_dir}/${legacy}"
      echo "  Removed legacy dist dir: ${legacy}/"
    fi
  done
  rmdir "${marketplace_dir}/plugins" 2>/dev/null || true

  echo "  Output → ${marketplace_dir}"
  echo ""

  local OUTPUT_DIR="${marketplace_dir}/${DIST_CLAUDE_SUBDIR}"

  # Copy plugin source into marketplace
  rm -rf "$OUTPUT_DIR"
  # rsync creates the destination leaf but NOT intermediate parents, and
  # DIST_CLAUDE_SUBDIR is nested (plugins/claude), so plugins/ must exist
  # first. macOS rsync tolerates the missing parent; rsync 3.2.7 on Linux
  # fails with "mkdir failed: No such file or directory (2)".
  mkdir -p "$OUTPUT_DIR"
  # -L dereferences symlinks into core/ (hooks/lib, scripts, receipt-schema) so the dist
  # gets real files — the marketplace copy is standalone, no symlink leakage.
  rsync -aL --exclude='__pycache__' --exclude='*.pyc' --exclude='assets/' "$PLUGIN_ROOT/" "$OUTPUT_DIR/"

  echo "  Copied plugin-claude/ → marketplace/${PLUGIN_NAME}/"

  # Authored bodies carry host-neutral {{include:}} / {{read:}} directives.
  # Expand them into Claude's native inline form in the DIST tree only; the
  # authored source stays host-neutral. Fails the build on a malformed directive
  # or an include naming a file that does not exist.
  if ! python3 "${REPO_ROOT}/core/scripts/expand_claude_directives.py" "$OUTPUT_DIR"; then
    echo "ERROR: directive expansion failed for the Claude package" >&2
    exit 1
  fi

  # Rewrite dist plugin.json "name" to match PLUGIN_NAME. The source tree
  # keeps name="synaptory" so local dev (claude --plugin-dir ./plugin-claude) is
  # unaffected; only the marketplace-published copy is renamed. Without
  # this, a synaptory-next build would advertise name="synaptory" and
  # collide with the stable install at load time.
  if [ "${PLUGIN_NAME}" != "synaptory" ] && [ -f "${OUTPUT_DIR}/.claude-plugin/plugin.json" ]; then
    python3 -c "
import json
p = '${OUTPUT_DIR}/.claude-plugin/plugin.json'
with open(p) as f:
    data = json.load(f)
data['name'] = '${PLUGIN_NAME}'
with open(p, 'w') as f:
    json.dump(data, f, indent=2)
    f.write('\n')
"
    echo "  Rewrote dist plugin.json name → ${PLUGIN_NAME}"
  fi

  # Stamp version + plugin name into dist README. PLUGIN_NAME varies by
  # channel (synaptory vs synaptory-next), and the README's install snippets
  # reference the plugin directory under ~/.claude/plugins — hard-coding
  # "synaptory" would break the pilot channel.
  if [ -f "${OUTPUT_DIR}/README.md" ]; then
    _sed_inplace -e "s/{{VERSION}}/${new_ver}/g" -e "s/{{PLUGIN_NAME}}/${PLUGIN_NAME}/g" "${OUTPUT_DIR}/README.md"
    echo "  Stamped README.md with v${new_ver} (${PLUGIN_NAME})"
  fi

  # ADR-008: the legacy auth/token Python modules
  # (access_token_manager.py et al.) were deleted from the source tree
  # along with the v2.1 access-token format. The CLI owns all auth and
  # skill delivery now — there is nothing to scrub from the dist.

  # Copy legal files from repo root into dist
  cp "${REPO_ROOT}/LICENSE" "${OUTPUT_DIR}/LICENSE"
  cp "${REPO_ROOT}/NOTICE" "${OUTPUT_DIR}/NOTICE"
  echo "  Copied LICENSE + NOTICE"

  # Build single-file HTML user guide. Pass the version explicitly so the
  # hero stamps are consistent with the rest of the release (CLI, plugin,
  # marketplace.json, container images all carry the same /VERSION). The
  # builder also writes web/dist/docs/user-guide.html as a side effect —
  # that's the file the prod-fs publish step copies to /mnt/pgdata/web-dist/docs/.
  SYNAPTORY_VERSION="${new_ver}" python3 "$USER_GUIDE_BUILDER" \
    --output "${OUTPUT_DIR}/GUIDE.html" \
    --version "${new_ver}"
  echo "  Built GUIDE.html (v${new_ver})"
  echo ""

  # ── Stub generation + IP-content removal ───────────────────────────────────
  #
  # Distribution model post-redesign (ADR-016): IP-sensitive bodies are NOT
  # shipped in the marketplace tree. They live on the control plane,
  # envelope-encrypted (ADR-003), and are delivered at runtime by
  # `synaptory skills get <name>` with per-UPN watermarking.
  #
  # What we do here:
  #   * Replace top-level skill SKILL.md and agent.md with stubs that call
  #     the CLI. Claude Code's loader expands the !`bash …` backtick at
  #     load time and embeds the watermarked body.
  #   * Drop directories that are CP-served end-to-end: protocols/, rules/,
  #     hooks/data/, _shared/protocols/, _shared/templates/.
  #   * Keep agent SKILL.md + phases/modes/tech-packs PLAINTEXT for now —
  #     these are loaded inside the agent prompt via Read or `!cat`, both
  #     of which need the file on local disk. Rewriting those references
  #     to use Bash/CLI is a follow-up cycle; stripping them here would
  #     break agent dispatch.
  #   * Keep _shared/scripts/ plaintext .py (runtime helpers). The .pyc
  #     bytecode obfuscation is dropped — separate hardening task.
  local stubs=0
  local dist_skills="${OUTPUT_DIR}/skills"

  # Top-level skill stubs (orchestrator etc.). _shared has no SKILL.md.
  for skill_dir in "$dist_skills"/*/; do
    [ -d "$skill_dir" ] || continue
    local sname=$(basename "$skill_dir")
    [ "$sname" = "_shared" ] && continue

    local smd="${skill_dir}SKILL.md"
    [ -f "$smd" ] || continue

    echo "  skill stub: $sname"
    generate_stub "$sname" "$smd" > "${smd}.tmp"
    mv "${smd}.tmp" "$smd"
    stubs=$((stubs + 1))
  done

  # Agent stubs — agent.md is the Claude Code subagent entry point;
  # stubbing it routes the subagent's body fetch through the CP. The
  # seeder stores it at name "<agent>/agent" (api/synaptory_api/seed.py
  # _skill_name_for: agents/<n>/agent.md → <n>/agent). We do NOT stub
  # SKILL.md here because the agent's first action is "Read SKILL.md",
  # and Read returns text without expanding `!` backticks — a SKILL.md
  # stub would just embed the literal command string in the agent's
  # context. Until agent.md is rewritten to call Bash instead of Read,
  # SKILL.md must remain plaintext.
  local dist_agents="${OUTPUT_DIR}/agents"
  if [ -d "$dist_agents" ]; then
    for agent_dir in "$dist_agents"/*/; do
      [ -d "$agent_dir" ] || continue
      local aname=$(basename "$agent_dir")
      local amd="${agent_dir}agent.md"
      [ -f "$amd" ] || continue
      echo "  agent stub: $aname"
      generate_stub "${aname}/agent" "$amd" > "${amd}.tmp"
      mv "${amd}.tmp" "$amd"
      stubs=$((stubs + 1))
    done
  fi

  # Drop CP-served content directories from the dist tree entirely.
  # Bodies are delivered at runtime via `synaptory skills get`; shipping
  # them here would defeat the IP wall and create stale-content drift.
  local dropped=0
  for purge in \
    "${OUTPUT_DIR}/rules" \
    "${OUTPUT_DIR}/skills/_shared/protocols" \
    "${OUTPUT_DIR}/skills/_shared/templates"; do
    if [ -d "$purge" ]; then
      rm -rf "$purge"
      dropped=$((dropped + 1))
    fi
  done
  # Compacted rules live under hooks/data/ — purge .md but keep the dir
  # in case hooks/data/ ever gains non-IP runtime config files.
  if [ -d "${OUTPUT_DIR}/hooks/data" ]; then
    find "${OUTPUT_DIR}/hooks/data" -name "*.md" -type f -delete 2>/dev/null || true
  fi

  # _shared/design-assets is build-time documentation, not runtime.
  if [ -d "${OUTPUT_DIR}/skills/_shared/design-assets" ]; then
    rm -rf "${OUTPUT_DIR}/skills/_shared/design-assets"
  fi

  echo "  Generated ${stubs} stubs; dropped ${dropped} CP-served dirs"

  # ── Phase 4.2: Generate integrity manifest ──────────────────────────────
  echo ""
  echo "  Generating integrity manifest..."
  local manifest="${OUTPUT_DIR}/hooks/.integrity-manifest"
  local manifest_count=0
  : > "$manifest"
  for hook_file in \
    "${OUTPUT_DIR}/hooks/hooks.json" \
    "${OUTPUT_DIR}/hooks/synaptory-decrypt-skill.sh" \
    "${OUTPUT_DIR}/hooks/synaptory-inject-protocols.sh" \
    "${OUTPUT_DIR}/hooks/synaptory-access-token-check.sh" \
    "${OUTPUT_DIR}/hooks/synaptory-access-token-cleanup.sh" \
    "${OUTPUT_DIR}/hooks/synaptory-load-rules.sh" \
    "${OUTPUT_DIR}/hooks/synaptory-verify-receipt.sh" \
    "${OUTPUT_DIR}/hooks/synaptory-session-start.sh" \
    "${OUTPUT_DIR}/hooks/synaptory-reanchor.sh" \
    "${OUTPUT_DIR}/hooks/session-guard.sh" \
    "${OUTPUT_DIR}/hooks/synaptory-pipeline-snapshot.sh" \
    "${OUTPUT_DIR}/hooks/synaptory-session-end.sh" \
    "${OUTPUT_DIR}/hooks/synaptory-config-fetch.sh"; do
    if [ -f "$hook_file" ]; then
      shasum -a 256 "$hook_file" | sed "s|${OUTPUT_DIR}/||g" >> "$manifest"
      manifest_count=$((manifest_count + 1))
    fi
  done
  # AST01-F1 (post-ADR-016): manifest covers what the dist actually carries
  # — stubs (SKILL.md, agent.md), plaintext agent bodies, plugin.json, and
  # any plain .md still shipped under skills/. The encrypted .enc form is
  # gone; runtime can compare on-disk bytes against this manifest to detect
  # tamper of the bits we still ship.
  while IFS= read -r -d '' f; do
    shasum -a 256 "$f" | sed "s|${OUTPUT_DIR}/||g" >> "$manifest"
    manifest_count=$((manifest_count + 1))
  done < <(find "${OUTPUT_DIR}/skills" "${OUTPUT_DIR}/agents" \
             -type f \( -name "*.md" -o -name "*.json" \) -print0 2>/dev/null)

  # AST02-F1: compute aggregate build_hash (SHA-256 of the manifest itself)
  # and write build-metadata.json so runtime can detect version drift.
  local build_hash
  build_hash=$(shasum -a 256 "$manifest" | cut -d' ' -f1)
  local build_meta="${OUTPUT_DIR}/.claude-plugin/build-metadata.json"
  local model_pins_src="${PLUGIN_ROOT}/skills/_shared/backends/model-pins.json"
  mkdir -p "$(dirname "$build_meta")"
  python3 -c "
import json, sys
from datetime import datetime, timezone

# HC0-F3: embed an AI-BOM (model-pins contents) into build metadata so the
# distribution carries a verifiable record of exactly which models the plugin
# dispatches to. (Per-model USD rates are no longer a pinned file — since #162
# they are derived from this org's Anthropic billing at runtime; see
# api/synaptory_api/anthropic_billing.py.)
try:
    with open('${model_pins_src}', 'r') as f:
        model_pins = json.load(f)
except FileNotFoundError:
    model_pins = {'error': 'model-pins.json not found at build time'}
ai_bom = {'model_pins': model_pins}

meta = {
    'version': '${new_ver}',
    'build_hash': '${build_hash}',
    'built_at': datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),
    'manifest_file_count': ${manifest_count},
    'ai_bom': ai_bom,
    'provenance': {
        'builder_user': __import__('os').environ.get('USER', 'unknown'),
        'builder_host': __import__('platform').node(),
        'git_commit': __import__('subprocess').run(
            ['git', 'rev-parse', 'HEAD'], capture_output=True, text=True,
            cwd='${PLUGIN_ROOT}',
        ).stdout.strip() or 'unknown',
        'git_dirty': bool(__import__('subprocess').run(
            ['git', 'status', '--porcelain'], capture_output=True, text=True,
            cwd='${PLUGIN_ROOT}',
        ).stdout.strip()),
    },
}
with open('${build_meta}', 'w') as f:
    json.dump(meta, f, indent=2)
"
  # The plaintext manifest stays at hooks/.integrity-manifest in the dist —
  # runtime tamper-detection reads it to verify on-disk bytes. Pre-ADR-016
  # this was encrypted and removed; now it ships as-is.
  echo "  Integrity manifest: ${manifest_count} files checksummed"
  echo "  Build hash: ${build_hash:0:16}…  (${build_meta})"

  # ── Update marketplace metadata ─────────────────────────────────────────
  echo ""
  echo "  Updating marketplace metadata..."

  # Update marketplace.json — upsert the ${PLUGIN_NAME} entry, preserve
  # every other plugin (e.g. tracker, or the sibling synaptory/synaptory-next
  # entry during the v2.5 pilot when both lines ship in parallel).
  python3 -c "
import json, sys

mp_path = '${marketplace_dir}/.claude-plugin/marketplace.json'
plugin_name = '${PLUGIN_NAME}'
with open(mp_path, 'r') as f:
    data = json.load(f)

entry = {
    'name': plugin_name,
    # Claude Code's marketplace schema uses a string for relative paths
    # within a marketplace repo (resolved from the marketplace root, i.e.
    # the dir containing .claude-plugin/marketplace.json). The object form
    # is reserved for external sources like {source:'github',repo:'…'}.
    # See https://code.claude.com/docs/en/plugin-marketplaces.
    'source': './${DIST_CLAUDE_SUBDIR}',
    'version': '${new_ver}',
    'author': {'name': 'H3Tech Inc.', 'url': 'https://h3t.co'},
    'license': 'PROPRIETARY'
}

plugins = data.get('plugins', [])
replaced = False
for i, p in enumerate(plugins):
    if p.get('name') == plugin_name:
        plugins[i] = entry
        replaced = True
        break
if not replaced:
    plugins.append(entry)
data['plugins'] = plugins

with open(mp_path, 'w') as f:
    json.dump(data, f, indent=2)
    f.write('\n')
"

  echo "  marketplace.json updated"

  # Friendly top-level alias served at /marketplace/plugin.json so the URL
  # surface matches the Caddy file_server layout (saves a deeper path).
  cp -f "${marketplace_dir}/.claude-plugin/marketplace.json" "${marketplace_dir}/plugin.json"

  # Catalog README. The publish path rsyncs with --delete, so a README added
  # by hand in the marketplace repo would be erased on the next release; it
  # has to be generated from the committed template on every build.
  local readme_src="${PLUGIN_ROOT}/assets/marketplace-README.md"
  if [[ -f "$readme_src" ]]; then
    sed "s/{{VERSION}}/${new_ver}/g" "$readme_src" > "${marketplace_dir}/README.md"
    echo "  catalog README → ${marketplace_dir}/README.md"
  fi

  echo "  plugin tree → ${marketplace_dir}/${DIST_CLAUDE_SUBDIR}/  (v${new_ver}, ${stubs} stubs)"
  echo ""
  echo "=========================================="
  echo "  Build complete — v${new_ver}"
  echo "=========================================="
  echo "  Images:  synaptory-{api,web,fixture-idp,backup,git-http}:v${new_ver}"
  echo "  CLI:     ${REPO_ROOT}/web/dist/cli/${new_ver}/"
  echo "  Plugin:  ${marketplace_dir}/${DIST_CLAUDE_SUBDIR}/"
  echo ""
  echo "  Next:    ./synaptory deploy local      # bring up local stack"
  echo "           ./synaptory deploy prod       # ship to production"
  echo ""
}

# _publish_plugin_to_git: commits the built marketplace tree and pushes it
# to a git remote. Used by cmd_deploy prod for both marketplace mirrors and by
# publish-path tests (file:// fake remotes). Operates on
# web/dist/marketplace/ (already populated by _build_plugin_tree).
#
# Args:
#   $1 = git remote URL (https://, file://, …). MUST NOT be logged if it
#        embeds a token.
#   $2 = human-readable label for log output (never a credential URL)
_publish_plugin_to_git() {
  local remote_url="$1" label="$2"
  local marketplace_dir="${REPO_ROOT}/web/dist/marketplace"
  local worktree="${REPO_ROOT}/infra/git/marketplace-worktree"
  local ver="$CURRENT_VERSION"

  if [[ ! -d "${marketplace_dir}" ]]; then
    echo "  ERROR: ${marketplace_dir} not found — run ./synaptory build first." >&2
    exit 1
  fi

  # Always clone fresh so each mirror publishes on top of its own main,
  # not a leftover worktree from the other marketplace transport.
  export GIT_TERMINAL_PROMPT=0
  # Origin URL must never embed a PAT. Callers that need GitHub auth set
  # GIT_ASKPASS + SYNAPTORY_MARKETPLACE_TOKEN around this function.
  local origin_url
  origin_url="$(printf '%s' "${remote_url}" | sed -E 's#^(https?://)[^/@]+@#\1#')"
  rm -rf "${worktree}"
  mkdir -p "$(dirname "${worktree}")"
  if git clone --quiet "${origin_url}" "${worktree}" 2>/dev/null; then
    echo "  Cloned worktree from ${label}"
  else
    mkdir -p "${worktree}"
    (cd "${worktree}" && git init -b main >/dev/null && git remote add origin "${origin_url}")
    echo "  Bootstrapped empty worktree (${label} has no history yet)"
  fi
  (cd "${worktree}" && \
    git checkout -B main >/dev/null 2>&1 || true
    git remote set-url origin "${origin_url}"
    git config --local credential.helper ""
    git config --local user.email "synaptory@h3t.co" && \
    git config --local user.name  "synaptory") || true

  echo "  Publishing plugin → ${label}"
  # Preserve the built artifact's file modes. Keeping destination permissions
  # lets independent marketplace histories drift (for example, a legacy
  # mirror can retain 0644 for hook scripts that are 0755 in the primary),
  # producing different Git trees and breaking direct hook execution.
  rsync -a --omit-dir-times --delete --exclude='.git' \
    "${marketplace_dir}/" "${worktree}/"

  (
    cd "${worktree}" || exit 1
    git add -A || exit 1
    if git diff --cached --quiet; then
      echo "    No changes vs the previous publish — skipping commit."
      exit 0
    fi
    if ! git commit -m "build v${ver} at $(date -u +%Y-%m-%dT%H:%M:%SZ)" >/dev/null; then
      echo "    ERROR: git commit failed in ${worktree}" >&2
      exit 1
    fi
    if ! git push origin HEAD:refs/heads/main >/dev/null; then
      echo "    ERROR: push to ${label} failed — nothing was published." >&2
      if [[ "$label" == github.com/* ]]; then
        echo "           Set RELEASE_BOT_PAT (or MARKETPLACE_GITHUB_TOKEN)" >&2
        echo "           with contents:write on ${SYNAPTORY_MARKETPLACE_GITHUB_REPO:-h3tech-ai/marketplace}." >&2
      else
        echo "           Verify the legacy bare repo exists and is writable by the release user." >&2
      fi
      exit 1
    fi
    echo "    Published commit $(git rev-parse --short HEAD) → ${label}"
  ) || exit 1
}

_marketplace_github_repo() {
  echo "${SYNAPTORY_MARKETPLACE_GITHUB_REPO:-h3tech-ai/marketplace}"
}

_marketplace_origin_url() {
  local repo
  repo="$(_marketplace_github_repo)"
  echo "https://github.com/${repo}.git"
}

_publish_plugin_to_github() {
  local repo token
  repo="$(_marketplace_github_repo)"
  token="${MARKETPLACE_GITHUB_TOKEN:-${RELEASE_BOT_PAT:-}}"
  if [[ -z "$token" ]]; then
    echo "  ERROR: RELEASE_BOT_PAT or MARKETPLACE_GITHUB_TOKEN is required to push to github.com/${repo}." >&2
    echo "         The PAT needs contents:write on that repository." >&2
    exit 1
  fi
  # Subshell so EXIT cleanup cannot clobber the build's cp-url trap and
  # cannot leave `askpass` unbound under `set -u` after this function returns.
  (
    askpass="$(mktemp "${TMPDIR:-/tmp}/synaptory-askpass.XXXXXX")"
    chmod 700 "$askpass"
    cat > "$askpass" <<'EOF'
#!/bin/sh
case "$1" in
  *[Uu]sername*) printf '%s\n' "x-access-token" ;;
  *) printf '%s\n' "${SYNAPTORY_MARKETPLACE_TOKEN:-}" ;;
esac
EOF
    cleanup() {
      rm -f "$askpass"
      unset SYNAPTORY_MARKETPLACE_TOKEN GIT_ASKPASS GIT_TERMINAL_PROMPT
    }
    trap cleanup EXIT
    export SYNAPTORY_MARKETPLACE_TOKEN="$token"
    export GIT_ASKPASS="$askpass"
    export GIT_TERMINAL_PROMPT=0
    _publish_plugin_to_git "$(_marketplace_origin_url)" "github.com/${repo}"
  )
}

_legacy_marketplace_origin_url() {
  echo "${SYNAPTORY_LEGACY_MARKETPLACE_ORIGIN:-file:///mnt/pgdata/git/marketplace.git}"
}

_publish_plugin_to_legacy() {
  _publish_plugin_to_git \
    "$(_legacy_marketplace_origin_url)" \
    "legacy synaptory.h3t.co/marketplace.git"
}

# Back-compat alias used by older publish-path callers/tests (#232).
_publish_plugin_to_bare() {
  _publish_plugin_to_git "$@"
}

