cmd_test() {
  # Test layers (Workstream C of the v2.5 test plan):
  #   syntax  : bash -n / py_compile / JSON parse
  #   pytest  : plugin-claude/tests/ (Layer 1 unit + Layer 2 hook integration)
  #
  # Default runs both. Flags select a single layer:
  #   --syntax  : legacy syntax-only mode
  #   --pytest  : pytest-only (skip syntax)
  local mode="all"
  while [ $# -gt 0 ]; do
    case "$1" in
      --syntax) mode="syntax"; shift ;;
      --pytest) mode="pytest"; shift ;;
      *) echo "Unknown ./synaptory test flag: $1" >&2; exit 2 ;;
    esac
  done

  local failed=0

  if [ "$mode" = "all" ] || [ "$mode" = "syntax" ]; then
    echo "  Running syntax validations..."
    echo ""
  fi

  if [ "$mode" = "pytest" ]; then
    # Skip the syntax block entirely.
    failed=0
  fi

  if [ "$mode" = "all" ] || [ "$mode" = "syntax" ]; then
  # Python syntax
  for py_file in \
    core/lib/state_machine.py \
    core/lib/scrum_state_machine.py \
    core/lib/kanban_state_machine.py \
    core/lib/story_pipeline.py \
    core/lib/receipt_validator.py \
    core/lib/verification_runner.py \
    core/lib/mode_reader.py \
    core/lib/update_claude_md.py \
    core/scripts/backend/backend_config.py \
    core/scripts/tracker/tracker_cli.py \
    plugin-claude/scripts/build_user_guide.py \
    plugin-cursor/hooks/lib/cursor_hook.py \
    plugin-cursor/mcp/server.py \
    plugin-cursor/scripts/compose.py \
    plugin-codex/plugins/synaptory/hooks/codex_hook.py \
    plugin-codex/plugins/synaptory/scripts/mcp_server.py \
    plugin-codex/scripts/compose.py; do
    if [ -f "$py_file" ]; then
      if python3 -c "import py_compile; py_compile.compile('$py_file', doraise=True)" 2>/dev/null; then
        echo "  OK  $py_file"
      else
        echo "  FAIL  $py_file"
        failed=$((failed + 1))
      fi
    fi
  done

  # JSON syntax
  for json_file in plugin-claude/hooks/hooks.json plugin-claude/.claude-plugin/plugin.json \
                   plugin-cursor/hooks/hooks.json \
                   plugin-cursor/.cursor-plugin/plugin.json \
                   plugin-cursor/mcp.json \
                   .cursor-plugin/marketplace.json \
                   plugin-codex/plugins/synaptory/hooks/hooks.json \
                   plugin-codex/plugins/synaptory/.codex-plugin/plugin.json \
                   plugin-codex/plugins/synaptory/.mcp.json \
                   plugin-codex/plugins/synaptory/assets/model-pins-codex.json \
                   plugin-codex/.agents/plugins/marketplace.json; do
    if [ -f "$json_file" ]; then
      if python3 -c "import json; json.load(open('$json_file'))" 2>/dev/null; then
        echo "  OK  $json_file"
      else
        echo "  FAIL  $json_file"
        failed=$((failed + 1))
      fi
    fi
  done

  # Shell syntax
  for sh_file in plugin-claude/hooks/*.sh plugin-cursor/hooks/*.sh plugin-cursor/scripts/*.sh \
                 plugin-codex/plugins/synaptory/hooks/*.sh; do
    if [ -f "$sh_file" ]; then
      if bash -n "$sh_file" 2>/dev/null; then
        echo "  OK  $sh_file"
      else
        echo "  FAIL  $sh_file"
        failed=$((failed + 1))
      fi
    fi
  done

  fi  # end syntax block

  if [ "$mode" = "all" ] || [ "$mode" = "pytest" ]; then
    # Layer 1 (unit) + Layer 2 (hook integration). The full e2e suite
    # ([Layer 3](e2e/scenarios/)) runs separately via ./synaptory e2e.
    echo ""
    echo "  Running pytest (plugin-claude/tests/ + plugin-cursor/tests/)..."
    echo ""
    local pytest_dirs=(plugin-claude/tests plugin-cursor/tests)
    if [[ -d plugin-codex/tests ]]; then
      pytest_dirs+=(plugin-codex/tests)
    fi
    if python3 -m pytest "${pytest_dirs[@]}" -q --no-header 2>&1; then
      :
    else
      failed=$((failed + 1))
    fi

    # Layer 2b: the cross-host conformance contract. Run as its OWN invocation
    # with an explicit -c rather than appended to pytest_dirs above. There is no
    # repo-root pytest config, so the combined run resolves rootdir to the repo
    # root and every per-tree ini silently deactivates; appending would inherit
    # that and lose --strict-markers, which this suite depends on.
    if [[ -d conformance ]]; then
      echo ""
      echo "  Running cross-host conformance contract (conformance/)..."
      echo ""
      if python3 -m pytest -c conformance/pytest.ini conformance -q --no-header 2>&1; then
        :
      else
        failed=$((failed + 1))
      fi
    fi
  fi

  echo ""
  if [ "$failed" -eq 0 ]; then
    echo "  All checks passed."
  else
    echo "  ${failed} check(s) failed."
    exit 1
  fi
}

# ── v2.5 stub commands (phases V1.0 / V1.1) ───────────────────────────────────
