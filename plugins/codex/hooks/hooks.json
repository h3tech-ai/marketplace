{
  "description": "Synaptory Codex lifecycle adapters",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/run-hook.sh\" SessionStart",
            "timeout": 3,
            "statusMessage": "Checking Synaptory project state...",
            "additionalContextLimit": 4096
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/run-hook.sh\" SessionEnd",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
