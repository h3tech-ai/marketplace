{
  "description": "Synaptory Codex lifecycle adapters",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/run-hook.sh\" SessionStart",
            "timeout": 3,
            "statusMessage": "Checking Synaptory project state...",
            "additionalContextLimit": 4096
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/run-hook.sh\" TelemetryFlush",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/run-hook.sh\" SessionEnd",
            "timeout": 2
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/run-hook.sh\" SubagentStop",
            "timeout": 10,
            "statusMessage": "Validating Synaptory receipt..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/run-hook.sh\" SubagentStart",
            "timeout": 10,
            "statusMessage": "Binding Synaptory dispatch telemetry..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/run-hook.sh\" Stop",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/run-hook.sh\" TelemetryFlush",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ]
  }
}
